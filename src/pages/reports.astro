---
import Base from "../layouts/Base.astro";
// import DriveFolder from "../components/DriveFolder.astro";
import DriveYearList from "../components/DriveYearList.astro";
import { site } from "../config";
---

<Base title="Reports">
  <h1>Reports</h1>
  <p>
    Our comprehensive water quality report ensures transparency and adherence to
    the{" "}
    <a
      href="https://ecology.wa.gov/Water-Shorelines/Water-quality/Water-quality-standards"
      target="_blank"
      rel="noopener noreferrer"
    >
      highest standards
    </a>
    . Through advanced filtration, rigorous testing, and constant monitoring, we
    guarantee that the water you receive is free from contaminants. Trust us to
    provide you with the best water quality for your peace of mind.
  </p>
  <p>
    To view all <strong>Department of Health (DOH)</strong> reports on the{" "}
    {site.name}, click the link below to visit Washington State's department of
    health. Read and accept the disclaimer and search for {site.name}. The Water
    System ID is <strong>87115N</strong>.
  </p>
  <a
    href="https://fortress.wa.gov/doh/eh/portal/odw/si/Disclaimer.aspx?Page=/portal/odw/si/listmultiwatersystems.aspx"
    target="_blank"
    rel="noopener noreferrer"
  >
    Washington State Department of Health - Division of Environmental Health -
    Office of Drinking Water
  </a>
  <p>
    To view all <strong>Consumer Confidence Reports (CCRs)</strong>, click the
    link below, scroll down to the "Annual Water Quality Reports" section, find{" "}
    {site.name}, and select the year you would like to view. H2O Management
    Services, Inc. provides these reports from 2024 onward. For reports prior to
    2024, view the reports below or contact the {site.name} directly.
  </p>
  <a
    href="https://h2omanagementservicesinc.com/water-quality-reports/"
    target="_blank"
    rel="noopener noreferrer"
  >
    H2O Management Services, Inc. - Water Quality Reports
  </a>

  <h2>Reports</h2>
  <DriveYearList folderId={site.driveFolders.reports} title="Reports" />
</Base>
