---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  return (await getCollection('news')).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <h1>{entry.data.title}</h1>
  <p class="muted">{entry.data.date.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}</p>
  <Content />
  <p><a href="/news">All news</a></p>
</Base>
