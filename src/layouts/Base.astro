---
import '../styles/global.css';
import AlertBanner from '../components/AlertBanner.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site } from '../config';

interface Props { title?: string; description?: string }
const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  ['/', 'Home'],
  ['/staff', 'Staff'],
  ['/meetings', 'Meetings'],
  ['/reports', 'Reports'],
  ['/news', 'News'],
  ['/resources', 'Resources'],
  ['/contact', 'Contact'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="google-site-verification"
      content="huYZOlMBGMcFhtCDBr1dK96xMlJKE3HwsGqAoCHR3bU"
    />
    <link rel="icon" href="/images/favicon.ico" />
    <script is:inline>
      // Set theme before first paint to avoid a flash.
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <AlertBanner />
      <div class="wrap bar">
        <div class="brand-actions">
          <a href="/" class="brand">
            <img src="/images/favicon.ico" alt={site.name} width="32" height="32" />
          </a>
          <ThemeToggle />
        </div>
        <nav id="site-nav" aria-label="Main">
          <ul>
            {nav.map(([href, label]) => (
              <li><a href={href} aria-current={path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="menu-toggle">
          <button id="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
            <span class="bars" aria-hidden="true"></span>
            <span>Menu</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{site.name} · {site.mailingAddress}</p>
        <p>Office {site.phone} · {site.hours}</p>
        <p>After-hours emergencies: <a href={`tel:${site.phone}`}>{site.phone}</a></p>
      </div>
    </footer>
    <script>
      const header = document.querySelector<HTMLElement>('.site-header')!;
      const btn = document.getElementById('nav-toggle')!;
      const nav = document.getElementById('site-nav')!;
      const mobile = matchMedia('(max-width: 56rem)');

      const isOpen = () => btn.getAttribute('aria-expanded') === 'true';
      const setOpen = (open: boolean) => {
        header.classList.toggle('nav-open', open);
        btn.setAttribute('aria-expanded', String(open));
      };

      btn.addEventListener('click', () => setOpen(!isOpen()));
      nav.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) setOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen()) { setOpen(false); btn.focus(); }
      });
      mobile.addEventListener('change', () => setOpen(false));

      // Keep anchor links from landing underneath the sticky header.
      const setHeight = () =>
        document.documentElement.style.setProperty('--header-h', header.offsetHeight + 'px');
      new ResizeObserver(setHeight).observe(header);
      setHeight();
    </script>
  </body>
</html>
